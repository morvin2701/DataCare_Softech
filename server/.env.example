# Copy this file to .env and fill in your SQL Server details.
# .env holds a password – do not share it or copy it into chat/email.

DB_SERVER=<your-sql-server-ip>
DB_PORT=1433
DB_USER=<sql-login>
DB_PASSWORD=change-me
# Database used by this app. It is created automatically if it does not exist.
DB_NAME=DcInvoice
# Set to true if your SQL Server requires encrypted connections.
DB_ENCRYPT=false

# Port the web app is served on: http://localhost:3000
PORT=3000

# Password for the first "admin" account (created on first run only). Change it in the app afterwards.
ADMIN_PASSWORD=<choose-a-strong-password>

# --- Only when the frontend is hosted elsewhere (e.g. Vercel) ---
# Origins allowed to call this API, comma separated. Wildcards allowed for preview deployments.
# Example: ALLOWED_ORIGINS=https://datacare-invoice.vercel.app,https://*.vercel.app
ALLOWED_ORIGINS=
# Set to true when running behind Caddy / nginx / Cloudflare so client IPs are read correctly.
TRUST_PROXY=false
# Bind address. 127.0.0.1 = only the reverse proxy on this machine can reach Node directly (recommended with Caddy).
HOST=0.0.0.0
